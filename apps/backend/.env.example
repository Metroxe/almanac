# Nia
NIA_API_KEY=
# Bootstrap once:
#   curl -X POST https://apigcp.trynia.ai/v2/fs \
#     -H "authorization: Bearer $NIA_API_KEY" \
#     -H "content-type: application/json" \
#     -d '{"name":"almanac","description":"site recipe index"}'
# Use the returned `id` as NIA_KB_ID.
NIA_KB_ID=

# Gates discoverer + bounty writes. Generate with: openssl rand -hex 32
ALMANAC_WRITE_TOKEN=change-me-long-random-string

PORT=8787

# Clustly bridge (optional — leave blank to disable bounty posting)
CLUSTLY_API_KEY=
CLUSTLY_WEBHOOK_SECRET=
# Set CLUSTLY_LIVE=true to actually post bounties + escrow USDC.
CLUSTLY_LIVE=false
# Set ALMANAC_SMOKE_TEST=true to run Playwright smoke tests on incoming deliveries.
ALMANAC_SMOKE_TEST=false
