{
	"name": "almanac-monorepo",
	"private": true,
	"version": "0.0.0",
	"description": "Almanac — site recipe index for coding agents (workspace root)",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc --build",
		"clean": "tsc --build --clean",
		"dev:mcp": "npm run -w @christopher_powroznik/almanac dev",
		"dev:backend": "npm run -w @almanac/backend dev",
		"dev:discover": "npm run -w @almanac/discoverer dev",
		"dev:bounty": "npm run -w @almanac/discoverer bounty",
		"start:mcp": "npm run -w @christopher_powroznik/almanac start",
		"start:backend": "npm run -w @almanac/backend start",
		"check": "biome check",
		"format": "biome format --write",
		"lint": "biome lint"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.6.2",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
