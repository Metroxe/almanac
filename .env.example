# Backend (you host)
NIA_API_KEY=
NIA_KB_ID=
ALMANAC_WRITE_TOKEN=change-me-long-random-string
PORT=8787

# Clustly bridge (optional — leave blank to disable bounty posting)
CLUSTLY_API_KEY=
CLUSTLY_WEBHOOK_SECRET=
# Set CLUSTLY_LIVE=true to actually post bounties + escrow USDC.
# Default (unset/false) returns stub task IDs and skips real on-chain calls.
CLUSTLY_LIVE=false
# Set ALMANAC_SMOKE_TEST=true to run Playwright smoke tests on incoming deliveries.
ALMANAC_SMOKE_TEST=false

# Discoverer (you run locally)
ALMANAC_BACKEND_URL=http://localhost:8787
# ALMANAC_WRITE_TOKEN reused from above

# Local MCP (users install) — typically only need to override for dev:
# ALMANAC_BACKEND_URL=http://localhost:8787
